local function FireRemote(name, ...)
    local remote = Remotes:FindFirstChild(name)

    if not remote then
        return false
    end

    local ok = pcall(function()
        if remote:IsA("RemoteEvent") then
            remote:FireServer(...)
        elseif remote:IsA("RemoteFunction") then
            remote:InvokeServer(...)
        end
    end)

    return ok
end

