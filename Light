-- =========================================================
-- NEW SESSION CUBE WEBHOOK
-- =========================================================

task.spawn(function()
    local index = LocalPlayer:WaitForChild("Index", 10)

    if not index then
        warn("[LightFarm] Index folder not found.")
        return
    end

    local sessionCubes = index:WaitForChild("SessionCubes", 10)

    if not sessionCubes then
        warn("[LightFarm] SessionCubes folder not found.")
        return
    end

    local previous = {}

    -- Do not report cubes that already existed when the script started.
    for _, cube in ipairs(sessionCubes:GetChildren()) do
        previous[cube.Name] = true
    end

    sessionCubes.ChildAdded:Connect(function(cube)
        if previous[cube.Name] then
            return
        end

        previous[cube.Name] = true

        SendWebhook(
            CONFIG.CUBE_WEBHOOK,
            "🎲 New Session Cube",
            ("You just obtained **%s**."):format(cube.Name),
            65280
        )
    end)
end)

