-- =========================================================
-- HELPERS
-- =========================================================

local function fire(remoteName, ...)
    local r = Remotes:FindFirstChild(remoteName)
    if not r then return false end

    return pcall(function()
        if r:IsA("RemoteFunction") then
            r:InvokeServer(...)
        else
            r:FireServer(...)
        end
    end)
end

local function getValue(parent, name)
    local obj = parent and parent:FindFirstChild(name)
    if not obj then return 0 end
    return tonumber(obj.Value) or 0
end

local function getItemsFolder()
    return Player:FindFirstChild("Items")
end

