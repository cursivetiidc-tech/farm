-- Capture the executor request function BEFORE defining any local
-- function named request. This avoids the bug in the previous build.
local executorRequest =
    http_request
    or (syn and syn.request)
    or (http and http.request)
    or request

local function SendWebhook(url, title, description, color)
    if not executorRequest or not url or url == "" then
        return
    end

    task.spawn(function()
        pcall(function()
            executorRequest({
                Url = url,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = HttpService:JSONEncode({
                    username = "LightFarm",
                    embeds = {
                        title = title,
                        description = description,
                        color = color or 5793266,
                        timestamp = DateTime.now():ToIsoDate()
                    }
                })
            })
        end)
    end)
end

