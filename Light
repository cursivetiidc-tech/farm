task.spawn(function()
    local index = Player:WaitForChild("Index", 15)
    local cubes = index and index:WaitForChild("SessionCubes", 15)

    if not cubes then
        warn("[LightFarm] SessionCubes folder not found.")
        return
    end

    -- Existing cubes are not reported.
    local known = {}

    for _, cube in ipairs(cubes:GetChildren()) do
        known[cube.Name] = true
    end

    cubes.ChildAdded:Connect(function(cube)
        if known[cube.Name] then return end
        known[cube.Name] = true

        webhook(
            CONFIG.CUBE_WEBHOOK,
            "🎲 New Session Cube",
            ("**%s** was added to your SessionCubes collection."):format(cube.Name)
        )
    end)
end)

