local executorRequest = http_request
    or (syn and syn.request)
    or (http and http.request)
    or _G.request

local function sendWebhookRequest(url, payload)
    if not url or url == "" or url:find("PUT_") then return end

    if not executorRequest then
        warn("[LightFarm] HTTP request function unavailable.")
        return
    end

    task.spawn(function()
        pcall(function()
            executorRequest({
                Url = url,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(payload)
            })
        end)
    end)
end

local function webhook(url, title, description)
    sendWebhookRequest(url, {
        username = "Light Farm",
        embeds = {{
            title = title,
            description = description,
            color = 5793266,
            timestamp = DateTime.now():ToIsoDate()
        }}
    })
end

