        local potions = getPotionCounts()

        local description =
            formatCounts("🎲 Dice", dice) ..
            "\n\n" ..
            formatCounts("🧪 Potions / Boosts", potions)

        webhook(CONFIG.STATS_WEBHOOK, "📊 Farm Bot Stats", description)

        task.wait(CONFIG.STATS_INTERVAL)
    end
end)

