-- 5. POTION / DICE WEBHOOK STATS EVERY 5 MINUTES
-- =========================================================

local function getDiceCounts()
    local items = getItemsFolder()
    local result = {}

    if not items then return result end

    local diceNames = {
        "Dice",
        "Ice Dice",
        "Fire Dice",
        "Insane Dice"
    }

    for _, name in ipairs(diceNames) do
        result[name] = getValue(items, name)
    end

    return result
end

local function getPotionCounts()
    local items = getItemsFolder()
    local result = {}

    if not items then return result end

    local ok, ItemsData = pcall(function()
        return require(ReplicatedStorage.Modules.Items)
    end)

    if not ok or type(ItemsData) ~= "table" then
        return result
    end

    for itemName, itemInfo in pairs(ItemsData) do
        if type(itemInfo) == "table" and itemInfo.Boost then
            result[itemName] = getValue(items, itemName)
        end
    end

    return result
end

local function formatCounts(title, counts)
    local lines = {}

    for name, amount in pairs(counts) do
        table.insert(lines, ("**%s:** %s"):format(name, tostring(amount)))
    end

    table.sort(lines)

    if #lines == 0 then
        return title .. "\nNone found."
    end

    return title .. "\n" .. table.concat(lines, "\n")
end

task.spawn(function()
    task.wait(5)

    while true do
