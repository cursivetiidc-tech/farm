-- =========================================================
-- INVENTORY HELPERS
-- =========================================================

local function getItemsFolder()
    return LocalPlayer:FindFirstChild("Items")
end

local function getCount(name)
    local items = getItemsFolder()
    if not items then
        return 0
    end

    local value = items:FindFirstChild(name)
    if not value then
        return 0
    end

    return tonumber(value.Value) or 0
end

local function getDiceCounts()
    local names = {
        "Dice",
        "Ice Dice",
        "Fire Dice",
        "Insane Dice"
    }

    local result = {}

    for _, name in ipairs(names) do
        result[name] = getCount(name)
    end

    return result
end

local function getPotionCounts()
    local items = getItemsFolder()
    local result = {}

    if not items then
        return result
    end

    local ok, ItemsData = pcall(function()
        return require(ReplicatedStorage.Modules.Items)
    end)

    if not ok or type(ItemsData) ~= "table" then
        return result
    end

    for itemName, info in pairs(ItemsData) do
        if type(info) == "table" and info.Boost then
            local obj = items:FindFirstChild(itemName)
            result[itemName] = obj and (tonumber(obj.Value) or 0) or 0
        end
    end

    return result
end

local function formatCounts(title, counts)
    local lines = {}

    for name, amount in pairs(counts) do
        table.insert(lines, ("**%s:** %s"):format(name, tostring(amount)))
    end

    table.sort(lines)

    if #lines == 0 then
        return title .. "\nNone found."
    end

    return title .. "\n" .. table.concat(lines, "\n")
end

